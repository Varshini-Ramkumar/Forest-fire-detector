rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' ||
        request.auth.token.email == 'admin@igniswatch.demo'
      );
    }

    function isOfficial() {
      return isSignedIn() && (
        getUserData().role == 'official' ||
        request.auth.token.email == 'official@igniswatch.demo'
      );
    }

    function isStaff() {
      return isAdmin() || isOfficial();
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Forest Zones Collection
    match /forestZones/{zoneId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Sensor Nodes Collection
    match /sensorNodes/{nodeId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // Alerts Collection
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Fire Incidents Collection
    match /fireIncidents/{incidentId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Sensor Readings (Telemetry)
    match /sensorReadings/{readingId} {
      allow read: if isSignedIn();
      allow create: if isStaff();
      allow delete: if isAdmin();
    }
  }
}
